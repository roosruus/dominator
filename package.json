  "license": "ISC",
  "engines": {
    "node": ">=24.11"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "babel-loader": "10.1.1",
    "cheerio": "1.2.0",
    "css-loader": "7.1.5",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "html-webpack-plugin": "5.6.8",
    "style-loader": "4.0.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@reduxjs/toolkit": "2.14.0",
    "lodash": "4.17.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
