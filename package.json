{
  "name": "dominator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shuffle My Kingdom: a kingdom card randomizer for the Dominion deck-building game",
  "scripts": {
    "build": "vite build",
    "deployToFirebase": "npm run build && firebase deploy",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "updatecarddata": "node ./scripts/updatecarddata.cjs"
  },
  "author": "roosruus",
  "license": "ISC",
  "engines": {
    "node": ">=24.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.2.1",
    "cheerio": "1.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@reduxjs/toolkit": "2.14.0",
    "lodash": "4.17.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
